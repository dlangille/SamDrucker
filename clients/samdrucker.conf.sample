# the URL for your sam drucker server
SAMDRUCKER_URL="https://samdrucker.example.org/samdrucker.php"

# the argument expected by your sam drucker server script
SAMDRUCKER_ARG="packages"

# you might need --cacert for self-signed certs
# Do not add --output: samdrucker.sh reads the server's reply to tell
# whether the check-in worked, and removes any --output it finds here.
CURL_OPTIONS="--silent"
